+// Decision logging: at each quiet cutoff at P >= 16, every quiet candidate
+struct Cand {
+  uint32_t node;       // decision id
+  uint32_t cost;       // nodes its search took (0 if not tried)
+  uint32_t hist;       // history score at decision time
+  uint8_t p, type, to, from, sq_class, dest_top, height, new_top, near,
+      reserve_after, hist_rank, opp_replies, opp_lines, tried, cut, order_pos,
+      frozen_dist, n_quiet;
+};
+FILE *g_log = std::fopen(std::getenv("CAND_OUT") ? std::getenv("CAND_OUT") : "/dev/null", "wb");
+uint32_t g_decision = 0;
+int topOf(uint64_t b, int sp) {  // 0 empty, 1 base, 2 column, 3 capital
+  const uint64_t st = (b >> (4 * sp)) & 7;
+  return st == 0 ? 0 : 64 - __builtin_clzll(st);
+}
+int squareClass(int sp) {
+  const int r = sp / 4, c = sp % 4;
+  const bool er = r == 0 || r == 3, ec = c == 0 || c == 3;
+  return er && ec ? 0 : er || ec ? 1 : 2;  // corner, edge, centre
+}
+// Runs of three through `sp` in which exactly one other cell already has
+// top `type` (one step from a line)
+int nearLines(uint64_t b, int sp, int type) {
+  int near = 0;
+  for (int s = 0; s < kNumLineShapes; ++s) {
+    const LineShape &ls = kLineShapes[s];
+    if (ls.count != 3) continue;
+    bool has = false;
+    int same = 0;
+    for (int i = 0; i < 3; ++i) {
+      if (ls.cells[i] == sp) has = true;
+      else same += topOf(b, ls.cells[i]) == type;
+    }
+    near += has && same == 1;
+  }
+  return near;
+}
