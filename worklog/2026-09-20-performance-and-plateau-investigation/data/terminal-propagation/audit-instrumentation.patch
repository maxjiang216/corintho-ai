+#include <atomic>
+#include <cstdio>
+namespace term_instr {
+std::atomic<long long> calls{0}, leaf_loss{0}, leaf_draw{0}, ded_win{0},
+    ded_loss{0}, ded_draw{0}, mismatch{0}, child_steps{0}, audits{0},
+    audit_nodes{0}, wrong_nodes{0}, wrong_root{0}, missed_nodes{0},
+    root_known{0}, root_wrong_kind[8][8];
+static int kind(Result r) {
+  if (r == kResultNone) return 0;
+  if (r == kResultLoss || r == kDeducedLoss) return 1;
+  if (r == kResultDraw || r == kDeducedDraw) return 2;
+  return 3;
+}
+struct Printer {
+  ~Printer() {
+    std::fprintf(stderr,
+      "#TERM fix=%d calls=%lld leaf_loss=%lld leaf_draw=%lld ded_win=%lld "
+      "ded_loss=%lld ded_draw=%lld buggy_vs_correct_mismatch=%lld "
+      "child_steps=%lld\n", TERM_FIX, calls.load(), leaf_loss.load(),
+      leaf_draw.load(), ded_win.load(), ded_loss.load(), ded_draw.load(),
+      mismatch.load(), child_steps.load());
+    std::fprintf(stderr,
+      "#AUDIT audits=%lld nodes=%lld wrong=%lld missed=%lld root_known=%lld "
+      "root_wrong=%lld\n", audits.load(), audit_nodes.load(),
+      wrong_nodes.load(), missed_nodes.load(), root_known.load(),
+      wrong_root.load());
+    const char *n[4] = {"none", "loss", "draw", "win"};
+    for (int a = 0; a < 4; ++a) for (int b = 0; b < 4; ++b)
+      if (root_wrong_kind[a][b])
+        std::fprintf(stderr, "#ROOTWRONG stored=%s true=%s count=%lld\n",
+                     n[a], n[b], root_wrong_kind[a][b].load());
+  }
+} printer;
+// Correct result of node from its subtree (0 none,1 loss,2 draw,3 win)
+static int audit(const Node *node) {
+  ++audit_nodes;
+  if (node->terminal()) return kind(node->result());
+  bool any_loss = false, all_known = true, any_draw = false;
+  int n = 0;
+  for (Node *c = node->first_child(); c != nullptr; c = c->next_sibling()) {
+    int k = audit(c);
+    ++n;
+    if (k == 1) any_loss = true;
+    else if (k == 0) all_known = false;
+    else if (k == 2) any_draw = true;
+  }
+  int truth = any_loss ? 3
+            : (all_known && n == node->num_legal_moves()) ? (any_draw ? 2 : 1)
+            : 0;
+  int stored = kind(node->result());
+  if (stored != truth) {
+    if (stored == 0) ++missed_nodes; else ++wrong_nodes;
+  }
+  return truth;
+}
+}  // namespace term_instr
