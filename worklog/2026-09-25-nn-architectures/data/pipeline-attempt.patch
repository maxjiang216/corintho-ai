+// --pipeline: network calls pipelined on one thread (entry 09). Each batch
+// is enqueued on its group's backend as soon as it arrives (input converted
+// and copied, network, output copied, all queued on the backend's CUDA
+// stream), at most two in flight, each computing only after the previous
+// batch's compute; then the oldest is finished (waited for, outputs
+// converted) and handed back. One batch's copies overlap the other's
+// compute.
+class PipelineWorker {
+ public:
+  using Result = std::pair<double, double>;
+  PipelineWorker() : thread_([this] { run(); }) {}
+  ~PipelineWorker() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    wake_.notify_one();
+    thread_.join();
+  }
+  std::future<Result> submit(Backend *backend, const float *batch, int32_t rows,
+                             float *values, float *probs) {
+    Job job{backend, batch, rows, values, probs, {}, {}};
+    std::future<Result> result = job.done.get_future();
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      queue_.push_back(std::move(job));
+    }
+    wake_.notify_one();
+    return result;
+  }
+
+ private:
+  struct Job {
+    Backend *backend;
+    const float *batch;
+    int32_t rows;
+    float *values, *probs;
+    std::promise<Result> done;
+    std::chrono::steady_clock::time_point start;
+  };
+  void run() {
+    std::deque<Job> in_flight;
+    void *last_compute = nullptr;
+    for (;;) {
+      Job job;
+      bool have_new = false;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        wake_.wait(lock, [&] {
+          return stop_ || !queue_.empty() || !in_flight.empty();
+        });
+        if (!queue_.empty() && in_flight.size() < 2) {
+          job = std::move(queue_.front());
+          queue_.pop_front();
+          have_new = true;
+        } else if (in_flight.empty()) {
+          return;  // stopping, nothing left
+        }
+      }
+      if (have_new) {
+        job.start = std::chrono::steady_clock::now();
+        last_compute = job.backend->enqueue(job.batch, job.rows, last_compute);
+        in_flight.push_back(std::move(job));
+        continue;  // enqueue whatever else is waiting before blocking
+      }
+      Job &oldest = in_flight.front();
+      oldest.backend->finish(oldest.values, oldest.probs);
+      oldest.done.set_value(
+          {std::chrono::duration<double>(std::chrono::steady_clock::now() -
+                                         oldest.start)
+               .count(),
+           0.0});
+      in_flight.pop_front();
+    }
+  }
+  std::mutex mutex_;
+  std::condition_variable wake_;
+  std::deque<Job> queue_;
+  bool stop_{false};
+  std::thread thread_;
+};
